# Etsy Open API credentials (register at https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Local callback port for the OAuth redirect (Etsy registered redirect must match)
ETSY_REDIRECT_PORT=8000

# Public host when hosted (e.g. Railway). When set, the OAuth redirect becomes
# https://{PUBLIC_HOST}/callback; locally it falls back to localhost:ETSY_REDIRECT_PORT.
# The public https://.../callback URL must also be registered in the Etsy app.
# PUBLIC_HOST=

# Local data dir for tokens and uploaded media (default: ~/.config/etsyagent)
# On Railway, point this at the mounted volume, e.g. ETSYAGENT_DATA_DIR=/data
# ETSYAGENT_DATA_DIR=

# LLM provider for listing content generation.
# Option A: any OpenAI-compatible endpoint (OpenAI, Together, Groq, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Option B: Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest