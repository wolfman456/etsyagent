# Etsy Open API credentials (register at https://www.etsy.com/developers/your-apps)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Local callback port for the OAuth redirect (Etsy registered redirect must match)
ETSY_REDIRECT_PORT=8000

# When hosted, set this to the public HTTPS base (e.g. on Railway use your
# RAILWAY_PUBLIC_DOMAIN) so OAuth redirects/callbacks hit the remote host:
#   PUBLIC_BASE_URL=https://yourapp.up.railway.app
PUBLIC_BASE_URL=

# Local data dir for tokens and uploaded media (default: ~/.config/etsyagent)
# ETSYAGENT_DATA_DIR=

# LLM provider for listing content generation.
# Option A: any OpenAI-compatible endpoint (OpenAI, Together, Groq, LM Studio, ...)
# Free fallback: Groq (console.groq.com, no card) — use base URL
# https://api.groq.com/openai/v1 and a current model, e.g. openai/gpt-oss-120b.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Endpoints that reject response_format (e.g. local Ollama) — set OPENAI_JSON_MODE=0
OPENAI_JSON_MODE=1
# Option B: Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest